# Sign-in with the company's identity provider (OIDC). Copy to secrets.toml
# (gitignored) and fill in the app's client from the provider. With client_id
# or client_secret blank, the page runs without sign-in.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
# A long random string that signs the sign-in cookie, e.g. from:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = ""
client_id = ""
client_secret = ""
# The issuer's discovery document, here an Okta org's own authorization server.
server_metadata_url = "https://integrator-4770627.okta.com/.well-known/openid-configuration"
# The ID token is what the page sends the gateway as the caller's proof.
expose_tokens = "id"
