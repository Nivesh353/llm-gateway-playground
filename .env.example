# Copy to .env and fill in. .env is gitignored: never commit real keys.

# The LLM gateway, and the virtual key every call is made with
# (LLM Gateway → Virtual Keys in the opencontroller console).
GATEWAY_URL=https://your-gateway.example.com
GATEWAY_VIRTUAL_KEY=

# Optional: trace each call into an opencontroller Observability project.
# Leave OBSERVABILITY_API_KEY empty to turn tracing off.
CONSOLE_URL=https://your-opencontroller-console.example.com
OBSERVABILITY_API_KEY=
OBSERVABILITY_PROJECT=llm-gateway-playground
SERVICE_NAME=llm-gateway-playground

# Optional: offer only these models (comma-separated gateway ids), e.g.
# MODELS=anthropic/claude-haiku-4-5-20251001,bedrock/amazon.nova-lite-v1:0
MODELS=
